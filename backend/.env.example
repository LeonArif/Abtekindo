# Copy to .env for local development. Never commit .env.

# --- Core ---
APP_ENV=development
PORT=8080
# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000

# --- Database ---
# Local dev uses the Docker Postgres from docker-compose.yml (sslmode=disable
# is fine on localhost). In production, point this at Supabase's *direct*
# connection string instead (Database settings -> Connection string -> "URI"),
# not the "Connection pooling" (port 6543) one: the app does its own pooling
# via pgxpool and loads custom enum types per physical connection, both of
# which are unreliable behind a transaction-mode pgbouncer pooler. Supabase
# requires sslmode=require (or verify-full with its CA) over the public
# internet, e.g.:
#   DATABASE_URL=postgres://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgres://abtekindo:abtekindo@localhost:5432/abtekindo?sslmode=disable

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-insecure-secret-change-me-0000000000
# Cookie domain. Leave empty for localhost; set to .abtekindo.com in production
# so the frontend and api. subdomain share the session cookie.
COOKIE_DOMAIN=

# --- Object storage (Cloudflare R2), optional in development ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL images are served from, e.g. https://img.abtekindo.com
R2_PUBLIC_BASE_URL=

# --- Email notifications (Resend), optional in development ---
RESEND_API_KEY=
LEAD_NOTIFY_FROM=
LEAD_NOTIFY_TO=

# --- Spam control (Cloudflare Turnstile), optional in development ---
# When empty, Turnstile verification is skipped and a warning is logged.
TURNSTILE_SECRET_KEY=

# --- Frontend cache revalidation webhook ---
FRONTEND_URL=http://localhost:3000
REVALIDATE_SECRET=dev-only-revalidate-secret
